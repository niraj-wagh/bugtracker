# ── Copy this to .env and fill in values ──────────────────────

# MongoDB Atlas connection string (from Atlas → Connect → Drivers)
MONGODB_URI=mongodb://bugtracker_db_user:Niraj020305@ac-qbo4bjh-shard-00-00.aghd6va.mongodb.net:27017,ac-qbo4bjh-shard-00-01.aghd6va.mongodb.net:27017,ac-qbo4bjh-shard-00-02.aghd6va.mongodb.net:27017/bugtracker?ssl=true&replicaSet=atlas-xij54h-shard-0&authSource=admin&appName=bug0

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_STRING

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Server
PORT=5000
NODE_ENV=production

# Frontend URL (for CORS) — your Vercel/Netlify domain
CORS_ORIGINS=https://your-app.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here